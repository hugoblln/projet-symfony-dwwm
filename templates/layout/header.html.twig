<header>
	<nav class="navbar">
		<div class="navbar-logo"> <a href="/"><img src="{{ asset('/img/test_logo.png')}}" width="150px" alt="logo locafoot"></a></div>
		<div class="navbar-links">
			<div class="navbar-links-items">
				<ul>
					<li><a href=" {{ path('app.index')}}">Home</a></li>
					<li><a href="{{ path('app.terrains.index')}}">Terrains</a></li>
					<li><a href="{{ path('app.contact.index')}}">Contact</a></li>
					{% if app.user %}
					<li><a href="#">Mes reservations</a></li>
					{% if 'ROLE_ADMIN' in app.user.roles %}
					<li><a href="{{ path('admin.index')}}">Admin</a></li>
					{% endif %}
					{% endif %}
				</ul>
			</div>

			<div class="navbar-links-button">
				{% if app.user %}
				<ul>
					<li><a href="/logout">Déconnexion</a></li>
					<li><a href="#">Profil</a></li>
				</ul>
				{% else %}
				<ul>
					<li><a href="{{ path('app.register')}}">Inscription</a></li>
					<li><a href="{{ path('app.login')}}">Connexion</a></li>
				</ul>
				{% endif %}
			</div>
		</div>
		<svg xmlns="http://www.w3.org/2000/svg" width="4em" height="4em" viewBox="0 0 24 24">
			<path fill="white" fill-rule="evenodd"
				d="M3.5 5a1 1 0 0 0 0 2h17a1 1 0 1 0 0-2zm-1 7a1 1 0 0 1 1-1h17a1 1 0 1 1 0 2h-17a1 1 0 0 1-1-1m0 6.001a1 1 0 0 1 1-1h17a1 1 0 1 1 0 2h-17a1 1 0 0 1-1-1"
				clip-rule="evenodd" />
		</svg>

		</div>
	</nav>
</header>
<script>
	const menuHamburger = document.querySelector("svg")
	const navLinks = document.querySelector(".navbar-links")

	menuHamburger.addEventListener('click', () => {
		navLinks.classList.toggle('mobile-menu')
	})
</script>