 <div class="card-list">
{% for terrain in terrains %}
   <div class="card-terrain">
     {% if terrain.imageName %}
    <img src="{{ vich_uploader_asset(terrain)}}" alt="image terrain" width="350px" loading="lazy">
    {% endif %}
    <div class="card-terrain-content">
    <div class="card-terrain-content-details">
    <h2>{{ terrain.complexe.nom }}</h2>
    <p><strong>Ou ?</strong> {{ terrain.complexe.ville }}</p>
    <p><strong>Type de terrain</strong> {{ terrain.typeTerrain }}</p>
    <p><strong>Taille</strong> {{ terrain.taille }}</p>
    </div>
    <div class="card-terrain-content-price">
    <h3>{{ terrain.tarifHeure }}€/H</h3>
    </div>
    </div>
    <h2 class="card-terrain-button"><a href=" {{ path('app.terrains.show', {slug:terrain.slug}) }}">Réserver maintenant</a></h2>
   </div>
{% endfor %}
</div>