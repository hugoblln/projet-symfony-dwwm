{% extends "base.html.twig" %}


{% block title %}
{{ terrain.nom }}
{{ parent() }}
{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('front') }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('front') }}
{% endblock %}

{% block body %}
{% include "Frontend/terrains/_banner.html.twig" %}
<section class="main-content">
<div class="row">
{% include "Frontend/terrains/_sidebar.html.twig" %}
{% include "Frontend/terrains/_content.html.twig" %}
</div>
{% if app.user %}
<h2>Dnnez votre avis</h2>
{% include "Frontend/terrains/_avisForm.html.twig" %}
{% else %}
 <div class="alert alert-info mt-2" role="alert">
 <p>
 <b>Attention!</b>
 <br/>
 Vous devez
 <a href="{{ path('app.login') }}">être connecté</a>
 pour laisser un commentaire.
 </p>
 </div>
 {% endif %}
<section class="avis">

{% for avis in allAvis %}
{% include "Frontend/terrains/_listAvis.html.twig" %}
{% endfor %}
</section>
{% endblock %}