{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form, {attr: {class: 'card p-3 js-filter-form'}})}}

{{ form_row(form.query) }}
<h3 class="mb-3">Prix</h3>
<div class="d-flex gap-2">
{{ form_row(form.min) }}
{{ form_row(form.max) }}
</div>



<button type="submit" class="btn btn-primary">Filtrer</button>
{{ form_end(form)}}