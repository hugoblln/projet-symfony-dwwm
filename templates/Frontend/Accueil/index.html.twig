{% extends './base.html.twig' %}

{% block title %}
Accueil
{{parent()}}
{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('admin') }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('admin') }}
{% endblock %}


{% block body %}
{% include "/Frontend/accueil/_banner.html.twig" %}
<div class="form-city">
    <p class="form-city-text">Cherche un terrain dans la ville de ton choix :</p>
    <form id="searchForm">
        <input class="form-city-input" type="text" id="villeInput" name="ville" placeholder="Entrez une ville">
        <div id="cityList"></div>
    </form>
</div>
<div id="suggestions"></div>
<script>
    const input = document.getElementById('villeInput');
    const suggestionsList = document.getElementById('suggestions');

    input.addEventListener('input', function () {
        const searchTerm = input.value.trim();
        if (searchTerm.length === 0) {
            suggestionsList.innerHTML = '';
            return;
        }

        fetch(`https://geo.api.gouv.fr/communes?nom=${searchTerm}&limit=5`)
            .then(response => response.json())
            .then(data => {
                suggestionsList.innerHTML = '';
                data.forEach(ville => {
                    const li = document.createElement('li');
                    li.textContent = ville.nom;
                    li.addEventListener('click', function () {

                        window.location.href = `/terrains/ville/${ville.nom}`;
                    });
                    suggestionsList.appendChild(li);
                });
            })
            .catch(error => {
                console.error('Une erreur s\'est produite lors de la recherche de villes:', error);
            });
    });
</script>

{% endblock %}