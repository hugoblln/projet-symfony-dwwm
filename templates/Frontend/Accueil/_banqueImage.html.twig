    </div>
    <div class="banque-image-img">
        <img src="{{ asset('/img/terrain3.jpg') }}" height="300px" width="400px" alt="terrain3">

        <h3>Lyon Centre</h3>
        <div class="banque-image-img-hidden"><a href="">en savoir plus</a></div>

