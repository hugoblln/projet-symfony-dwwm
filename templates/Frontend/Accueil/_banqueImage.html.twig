    <div class="banque-image-img">
        <img src="{{ asset('/img/terrain4.jpg') }}" height="300px" width="400px" alt="terrain4">

        <h3>Lyon Centre</h3>
        <div class="banque-image-img-hidden"><a href="">en savoir plus</a></div>

    </div>
    <div class="banque-image-img">
        <img src="{{ asset('/img/terrain5.jpg') }}" height="300px" width="400px" alt="terrain5">

        <h3>Lyon Centre</h3>
