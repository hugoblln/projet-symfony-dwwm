{% extends "base.html.twig" %}

{% block title %}
{{ parent() }}
{% endblock %}

{% block body %}
<h1>Mon Profil</h1>
<section class="main-content">
    {% include "Security/Profil/_formProfil.html.twig" %}
</section>
 <form action="{{ path('profil.delete', {id: user.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte')">
                    <input type="hidden" name="token" value="{{ csrf_token('delete'~ user.id) }}">
                                    <button type="submit" class="button btn-secondaire">Supprimer</button>
                                </form>
{% endblock %}