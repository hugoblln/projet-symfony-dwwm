{% extends 'base.html.twig' %}

{% block title %}
Administration des complexes
{{ parent() }}
{% endblock %}


{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('admin') }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('admin') }}
{% endblock %}


{% block body %}
<section class="container mt-4">
    <h1 class="text-center">Administration des complexes</h1>
    <div class="table-responsive">
        <table class="table table-striped table-bordered" data-toggle="table" data-sort-name="fullName"
            data-sort-order="asc" data-pagination="true" data-search="true" data-show-columns="true">
            <thead>
                <tr scope="row">
                    <th scope="col" data-field="id">Id</th>
                    <th scope="col" data-field="nom" data-sortable="true">nom</th>
                      <th scope="col" data-field="proprietaire" data-sortable="true">proprietaire</th>
                    <th scope="col" data-field="adresse" data-sortable="true">complexe</th>
                    <th scope="col" data-field="description" data-sortable="true">description</th>
                    <th scope="col" data-field="ouverture" data-sortable="true">Heure d'ouverture</th>
                    <th scope="col" data-field="fermeture" data-sortable="true">heure de fermeture</th>
                      <th scope="col" data-field="telephone" data-sortable="true">téléphone</th>
                    <th scope="col" data-field="createdAt" data-sortable="true">date de création</th>
                    <th scope="col" data-field="updatedAt" data-sortable="true">date de dernière maj</th>
                    <th scope="col" data-field="enable" data-sortable="true">Actif</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                {% include "/Backend/Admin/complexes/ComplexeRow.html.twig" %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}