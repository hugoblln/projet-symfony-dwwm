{% extends "base.html.twig" %}

{% block title %}
{{parent()}}
Administration des avis
{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('admin') }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('admin') }}
{% endblock %}

{% block body %}
<section class="container mt-2">
    <section class="container mt-2">
        <h1 class="text-center">Administration des avis pour le terrain {{ terrain.nom}} du {{ complexe.nom }}</h1>
        <a href="{{ path('admin.terrains.complexe', {nom:complexe.nom}) }}" class="btn btn-primary my-2">retour aux terrains</a>
        <div class="table-responsive">
            <table class="table table-striped table-bordered" data-toggle="table" data-sort-name="fullName"
                data-sort-order="asc" data-pagination="true" data-search="true" data-show-columns="true">
                <thead>
                    <tr scope="row">
                        <th scope="col" data-field="id">Id</th>
                        <th scope="col" data-field="nom" data-sortable="true">utilisateur</th>
                         <th scope="col" data-field="note" data-sortable="true">note</th>
                        <th scope="col" data-field="typeTerrain" data-sortable="true">commentaire</th>
                        <th scope="col" data-field="createdAt" data-sortable="true">date de création</th>
                        <th scope="col" data-field="updatedAt" data-sortable="true">date de dernière maj</th>
                         <th scope="col" data-field="enable" data-sortable="true">Actif</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    {% include "/Backend/Admin/Avis/AvisRow.html.twig" %}
                </tbody>
            </table>
        </div>
    </section>

{% endblock %}