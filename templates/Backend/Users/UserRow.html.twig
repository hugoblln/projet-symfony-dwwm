{% for user in users %}
<tr scope="row">
    <td scope="col">{{ user.id }}</td>
    <td scope="col">{{ user.lastName}}</td>
    <td scope="col">{{ user.email}}</td>
    <td scope="col">{{ user.roles|join(', ') }}</td>
    <td scope="col">{{ user.createdAt|date('Y-m-d H:i:s') }}</td>

    <td scope="col">

        <div class="d-flex gap-2">
            <a href="{{path('admin.users.edit', {id:user.id})}}" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i>
                Modifier</a>
            {% include "/Backend/Users/_deleteForm.html.twig" %}
        </div>
    </td>
</tr>
{% endfor %}