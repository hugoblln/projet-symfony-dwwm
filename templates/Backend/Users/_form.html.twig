{{ form_start(form, {'attr': {'class': 'card p-3 w-75 mx-auto'}}) }}

<div class="row">
    <div class="col-md-6">
    {{form_row(form.FirstName, { 'attr' : {'readonly': 'readonly'}})}}
    </div>
    <div class="col-md-6">
    {{form_row(form.LastName, { 'attr' : {'readonly': 'readonly'}})}}
    </div>
</div>

{{form_row(form.email, { 'attr' : {'readonly': 'readonly'}})}}

{{form_row(form.roles)}}


<button type="submit" class="btn btn-primary">Modifier</button>
{{form_end(form) }}
