{{ form_start(form, {'attr': {'class': 'card w-75 p-3 mx-auto mt-4'}})}}
{{form_row(form.nom, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.adresse, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.description, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.HeureOuverture, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.HeureFermeture, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.telephone, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{{form_row(form.ville, {'attr':{ 'readonly': app.request.pathInfo matches '{/admin/}' ? 'readonly' : false}})}}
{% if app.request.pathInfo matches '{/admin}' %}
{{form_row(form.enable)}}
{% endif %}
<button type="submit" class="btn btn-primary">{{ labelButton }}</button>
{{ form_end(form)}}